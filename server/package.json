{
  "name": "crm-server",
  "version": "0.1.0",
  "private": true,
  "description": "Headless AI-native CRM — core logic + MCP adapter over Supabase/Postgres",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/mcp/server.ts",
    "mcp": "tsx --env-file=.env src/mcp/server.ts",
    "smoke": "tsx --env-file=.env src/smoke.ts",
    "mcp-smoke": "tsx --env-file=.env src/mcp-smoke.ts",
    "seed": "tsx --env-file=.env src/seed-demo.ts",
    "reset-demo:wipe": "tsx --env-file=.env src/reset-demo.ts",
    "reset-demo": "tsx --env-file=.env src/reset-demo.ts && tsx --env-file=.env src/seed-demo.ts",
    "provision": "tsx --env-file=.env src/provision-workspace.ts",
    "provision:prod": "tsx --env-file=.env.prod src/provision-workspace.ts",
    "inspect": "tsx --env-file=.env src/inspect.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "cf-build": "wrangler deploy --dry-run --outdir dist-worker",
    "cf-dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:advisor": "wrangler deploy --config wrangler.advisor.jsonc"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.45.0",
    "agents": "^0.17.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260707.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.107.0"
  }
}
