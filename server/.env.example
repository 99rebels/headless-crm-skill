# Copy to .env and fill from Supabase → Project Settings → API. Never commit .env.
# .env      = the DEV Supabase project (seed/smoke/inspect run against this — safe to wipe/reseed).
# .env.prod = the PROD Supabase project (real customer data, incl. the design partner). Used by
#             `npm run provision:prod`. Same two keys, different project. Also gitignored.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
